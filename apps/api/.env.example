# App runtime
SIFT_ENVIRONMENT=development
SIFT_CORS_ORIGINS=http://localhost:3000

# Managed services. Supply complete groups when integration begins in later phases.
SIFT_SUPABASE_URL=https://your-project-ref.supabase.co
SIFT_SUPABASE_JWT_AUDIENCE=authenticated
SIFT_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SIFT_QDRANT_URL=https://your-cluster.cloud.qdrant.io
SIFT_QDRANT_API_KEY=your-qdrant-api-key
SIFT_QDRANT_COLLECTION=sift_chunks
SIFT_CHAT_MODEL=gpt-4.1-mini
SIFT_INNGEST_EVENT_KEY=your-inngest-event-key
SIFT_INNGEST_SIGNING_KEY=your-inngest-signing-key
# Local development uses the Inngest Dev Server (npx inngest-cli@latest dev);
# Inngest Cloud uses https://inn.gs
SIFT_INNGEST_API_BASE_URL=http://127.0.0.1:8288
